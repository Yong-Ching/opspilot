# Copy to apps/api/.env (and never commit real values)
OPSPILOT_ENV=dev
OPSPILOT_DEBUG=true
OPSPILOT_DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_REDIS_URL=redis://localhost:6379/0

# LLM providers (Phase 3) — set spend limits in each console first
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Web (apps/web/.env.local)
API_URL=http://localhost:8000

# Legacy OMS (apps/legacy-oms/.env) — Acme's system, not OpsPilot's
ACME_DATABASE_URL=postgresql://acme:acme@localhost:5432/acme_oms
ACME_API_KEYS=["dev-acme-key"]
ACME_WEBHOOK_URLS=[]
