# Copy to apps/api/.env (and never commit real values)
OPSPILOT_ENV=dev
OPSPILOT_DEBUG=true
OPSPILOT_DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_REDIS_URL=redis://localhost:6379/0

# LLM providers (Phase 3) — set spend limits in each console first
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Web (apps/web/.env.local)
API_URL=http://localhost:8000

# Legacy PMS (apps/legacy-pms/.env): Harbourfront's system, not ResearchPilot's
HC_DATABASE_URL=postgresql://hc:hc@localhost:5432/hc_pms
HC_API_KEYS=["dev-hc-key"]
HC_WEBHOOK_URLS=[]
